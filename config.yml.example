homeserver: "https://matrix.srz.one"
user_id: "@teambot:matrix.srz.one"
password: "dein-bot-passwort"
room_id: "!HAUPTRAUM-ID:matrix.srz.one"
admin_room_id: "!ADMIN-RAUM-ID:matrix.srz.one"

db_path: "data/teambot.db"

# Spieltag-Einstellungen
vote_weekday: 5    # 0=Mo … 6=So (5=Samstag)
vote_hour: 12
vote_minute: 0

team_weekday: 6    # Sonntag
team_hour: 9
team_minute: 0

game_hour: 10
game_minute: 0

# Abstimmungs-Emojis
vote_yes: "✅"
vote_no: "❌"

# Standort für Wettervorhersage im Vote-Poll (Open-Meteo, kein API-Key nötig).
# Auskommentiert lassen wenn keine Wetteranzeige gewünscht ist.
# weather_lat: 52.5200
# weather_lon: 13.4050

# Optionaler zweiter Account für Poll-Versand (WA-Bridge-Workaround)
# Polls werden von diesem User gesendet damit die WA-Bridge sie akzeptiert.
# Leer lassen wenn nicht benötigt.
poll_sender_id: "@phil:matrix.srz.one"
poll_sender_password: "dein-phil-passwort"
